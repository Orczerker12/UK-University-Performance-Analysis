              <groupfilter function='member' level='[none:Calculation_1058296362848267:nk]' member='&quot;Chosen University&quot;' />
              <groupfilter function='member' level='[none:Calculation_1058296362848267:nk]' member='&quot;National Avg&quot;' />
              <groupfilter function='member' level='[none:Calculation_1058296362848267:nk]' member='&quot;Top 10\% Avg&quot;' />
