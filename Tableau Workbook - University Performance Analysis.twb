            <column caption='Avg Entry Standards' datatype='real' name='[Calculation_1058296346271745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[Entry Standards] - { FIXED : MIN([Entry Standards]) }&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;{ FIXED : MAX([Entry Standards]) } - { FIXED : MIN([Entry Standards]) }&#13;&#10;)' />
            </column>
            <column caption='Avg Graduate Outcomes' datatype='real' name='[Calculation_1058296347660290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[Graduate Prospects - Outcomes] - { FIXED : MIN([Graduate Prospects - Outcomes]) }&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;{ FIXED : MAX([Graduate Prospects - Outcomes]) } - { FIXED : MIN([Graduate Prospects - Outcomes]) }&#13;&#10;)' />
            </column>
            <column caption='Avg Research Quality' datatype='real' name='[Calculation_1058296347889667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[Research Quality] - { FIXED : MIN([Research Quality]) }&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;{ FIXED : MAX([Research Quality]) } - { FIXED : MIN([Research Quality]) }&#13;&#10;)' />
            </column>
            <column caption='Avg Good Honours' datatype='real' name='[Calculation_1058296349437956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[Good Honours] - { FIXED : MIN([Good Honours]) }&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;{ FIXED : MAX([Good Honours]) } - { FIXED : MIN([Good Honours]) }&#13;&#10;)' />
            </column>
            <column caption='Avg Degree Completion' datatype='real' name='[Calculation_1058296349544453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[Degree Completion] - { FIXED : MIN([Degree Completion]) }&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;{ FIXED : MAX([Degree Completion]) } - { FIXED : MIN([Degree Completion]) }&#13;&#10;)' />
