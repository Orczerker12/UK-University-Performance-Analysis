    <worksheet name='KPI (Chosen Uni Rank)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='in (Complete_University_Guide_University_League_Table 1 (3))' name='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='University name' datatype='string' name='[Parameter 1058296362258442]' param-domain-type='list' role='measure' source-field='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[Calculation_0970336804003842]' type='nominal' value='&quot;Brunel University of London&quot;'>
              <calculation class='tableau' formula='&quot;Brunel University of London&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column caption='University Filter' datatype='string' name='[Calculation_0970336804003842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Removing the below merged universities since they ceased to exist&#13;&#10;// before our subjects dataset. (THIS IS FOR HESA SUBJECT DATA 2021-2025).&#13;&#10;&#13;&#10;IF [Institution] &lt;&gt; &quot;University of Wales, Newport (Merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Glamorgan (merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Wales, Lampeter&quot;&#13;&#10;THEN [Institution]&#13;&#10;END' />
            </column>
            <column caption='University = University Parameter' datatype='boolean' name='[Calculation_1241090599424001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Institution] = [Parameters].[Parameter 1058296362258442]' />
            </column>
            <column caption='LOD Rank Percentile' datatype='integer' datatype-customized='true' name='[Calculation_1241090608222214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(1, CEILING((1 - (&#13;&#10;{ FIXED : COUNTD([Institution]) }&#13;&#10;-&#13;&#10;[Calculation_1241090611404807]&#13;&#10;+ 1&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : COUNTD([Institution]) }) * 100))' />
            </column>
            <column caption='Latest Uni Rank' datatype='integer' name='[Calculation_1241090611404807]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Institution] :&#13;&#10;    MIN(&#13;&#10;        IF [Year] = { FIXED : MIN(YEAR(TODAY())) }&#13;&#10;        THEN [Rank]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Latest Uni Count' datatype='integer' name='[Calculation_1241090612326408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF [Year] = { FIXED : MIN(YEAR(TODAY()))}&#13;&#10;        THEN [Institution]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='After number 1st 2nd 3rd 4th' datatype='string' name='[Calculation_1241090613932041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT(STR([Calculation_1241090608222214]), 1) = &quot;1&quot; THEN &quot;st&quot;&#13;&#10;ELSEIF RIGHT(STR([Calculation_1241090608222214]), 1) = &quot;2&quot; THEN &quot;nd&quot;&#13;&#10;ELSEIF RIGHT(STR([Calculation_1241090608222214]), 1) = &quot;3&quot; THEN &quot;rd&quot;&#13;&#10;ELSE &quot;th&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Institution]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Rank]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1241090608222214]' derivation='Avg' name='[avg:Calculation_1241090608222214:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1241090612326408]' derivation='Avg' name='[avg:Calculation_1241090612326408:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1241090599424001]' derivation='None' name='[none:Calculation_1241090599424001:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1241090611404807]' derivation='None' name='[none:Calculation_1241090611404807:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1241090613932041]' derivation='None' name='[none:Calculation_1241090613932041:nk]' pivot='key' type='nominal' />
