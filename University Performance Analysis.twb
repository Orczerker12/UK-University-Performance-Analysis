          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='University name' datatype='string' name='[Parameter 1058296362258442]' param-domain-type='list' role='measure' source-field='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[Calculation_0970336804003842]' type='nominal' value='&quot;Brunel University of London&quot;'>
              <calculation class='tableau' formula='&quot;Brunel University of London&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column datatype='integer' name='[Academic Services Spend]' role='measure' type='quantitative' />
            <column caption='University Filter' datatype='string' name='[Calculation_0970336804003842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Removing the below merged universities since they ceased to exist&#13;&#10;// before our subjects dataset. (THIS IS FOR HESA SUBJECT DATA 2021-2025).&#13;&#10;&#13;&#10;IF [Institution] &lt;&gt; &quot;University of Wales, Newport (Merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Glamorgan (merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Wales, Lampeter&quot;&#13;&#10;THEN [Institution]&#13;&#10;END' />
            </column>
            <column caption='University vs. National Avg' datatype='string' name='[Calculation_1058296362848267]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Institution] = [Parameters].[Parameter 1058296362258442] THEN &quot;Chosen University&quot;&#13;&#10;ELSEIF [Calculation_1058296415952922] THEN &quot;Top 10% Avg&quot;&#13;&#10;ELSE &quot;National Avg&quot;&#13;&#10;END' />
            </column>
            <column caption='Uni top 10 % cut off' datatype='boolean' name='[Calculation_1058296415952922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Rank] &lt;= { FIXED: CEILING(0.1 * COUNTD([Institution]))}' />
            </column>
            <column caption='University = University Parameter' datatype='boolean' name='[Calculation_1241090599424001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Institution] = [Parameters].[Parameter 1058296362258442]' />
            </column>
            <column caption='National Academic Services Spend' datatype='real' name='[Calculation_1472539106803718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Year]: AVG([Academic Services Spend]) }' />
            </column>
            <column caption='Academic Services Spend (top 10%)' datatype='real' name='[Calculation_1472539107995657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Year]: AVG(IF [Calculation_1058296415952922] THEN [Academic Services Spend] END )}' />
            </column>
            <column datatype='string' name='[Institution]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Rank]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Academic Services Spend]' derivation='Avg' name='[avg:Academic Services Spend:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1472539106803718]' derivation='Avg' name='[avg:Calculation_1472539106803718:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1472539107995657]' derivation='Avg' name='[avg:Calculation_1472539107995657:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1058296362848267]' derivation='None' name='[none:Calculation_1058296362848267:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1241090599424001]' derivation='None' name='[none:Calculation_1241090599424001:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
