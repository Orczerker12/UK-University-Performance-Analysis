      </column>
      <column caption='Top 10% avg score' datatype='real' name='[Calculation_0970336903159819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Year]: AVG(IF [Calculation_1058296415952922] THEN [Overall Score] END) }' />
      </column>
      <column caption='Subject % of Total' datatype='real' name='[Calculation_0970336954265626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pivot Field Values])&#13;&#10;/&#13;&#10;SUM({ FIXED [Institution], [Year] : SUM([Pivot Field Values]) })' />
      </column>
      <column caption='CY Score' datatype='real' name='[Calculation_1034382714945537]' role='measure' type='quantitative'>
