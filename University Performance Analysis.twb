    <worksheet name='Scatter (Research Quality &amp; Grad Prospects'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='14'>Research Quality &amp; Graduate Prospects</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Average research quality vs. average success in graduate employment. Colour shows details about Brunel vs. other universities. Graduate Outcomes data starts in 2022.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='in (Complete_University_Guide_University_League_Table 1 (3))' name='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa' />
          </datasources>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column datatype='real' name='[Graduate Prospects - Outcomes]' role='measure' type='quantitative' />
            <column datatype='string' name='[Institution]' role='dimension' type='nominal' />
            <column datatype='real' name='[Research Quality]' role='measure' type='quantitative' />
            <column caption='Current Year Filter' datatype='integer' name='[Year (copy)_0896398620786690]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Year]' />
            </column>
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Graduate Prospects - Outcomes]' derivation='Avg' name='[avg:Graduate Prospects - Outcomes:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Research Quality]' derivation='Avg' name='[avg:Research Quality:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Brunel]' derivation='InOut' name='[io:Brunel:nk]' pivot='key' type='nominal'>
              <aliases>
                <alias key='false' value='Others' />
                <alias key='true' value='Brunel' />
              </aliases>
            </column-instance>
            <column-instance column='[Institution]' derivation='None' name='[none:Institution:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year (copy)_0896398620786690]' derivation='None' name='[none:Year (copy)_0896398620786690:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[none:Year (copy)_0896398620786690:ok]'>
            <groupfilter expression='[Year (copy)_0896398620786690] = YEAR(tODAY())' function='filter' user:ui-marker='filter-by'>
              <groupfilter function='level-members' level='[none:Year (copy)_0896398620786690:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
