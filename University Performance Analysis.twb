    <worksheet name='Bar (Student Satisfaction Benchmark)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Student Satisfaction</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='in (Complete_University_Guide_University_League_Table 1 (3))' name='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='University name' datatype='string' name='[Parameter 1058296362258442]' param-domain-type='list' role='measure' source-field='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[Calculation_0970336804003842]' type='nominal' value='&quot;Brunel University of London&quot;'>
              <calculation class='tableau' formula='&quot;Brunel University of London&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column caption='Student Satisfaction Neutral' datatype='string' name='[Calculation_0319429459734545]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0718002208309284] = 0 THEN &quot;—&quot; END' />
            </column>
            <column caption='CY National Student Satisfaction' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429485846553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Year] = YEAR(TODAY()) THEN [Student Satisfaction] END )}' />
            </column>
            <column caption='CY Top 10%' datatype='boolean' name='[Calculation_0319429498785820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Year] = { FIXED : AVG(YEAR(TODAY())) }&#13;&#10;AND [Rank] &lt;= { FIXED : CEILING(0.1 * COUNTD([Institution])) }' />
            </column>
            <column caption='CY Student Satisfaction (top 10%)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429500325925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Calculation_0319429498785820] AND [Year] = YEAR(TODAY()) THEN [Student Satisfaction] END) }' />
            </column>
            <column caption='Student Satisfaction YoY' datatype='real' default-format='p0.00%' name='[Calculation_0718002208309284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(IF [Year] = YEAR(TODAY()) THEN [Student Satisfaction] END)&#13;&#10;- AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Student Satisfaction] END))&#13;&#10;/ AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Student Satisfaction] END)' />
            </column>
            <column caption='Student Satisfaction Increase' datatype='string' name='[Calculation_0718002216538158]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0718002208309284] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Student Satisfaction Decrease' datatype='string' name='[Calculation_0718002222219325]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0718002208309284] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='CY Student Satisfaction' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0718002241253447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Year] = YEAR(TODAY()) THEN [Student Satisfaction] END)' />
            </column>
            <column caption='University Filter' datatype='string' name='[Calculation_0970336804003842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Removing the below merged universities since they ceased to exist&#13;&#10;// before our subjects dataset. (THIS IS FOR HESA SUBJECT DATA 2021-2025).&#13;&#10;&#13;&#10;IF [Institution] &lt;&gt; &quot;University of Wales, Newport (Merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Glamorgan (merged to form University of South Wales)&quot;&#13;&#10;AND [Institution] &lt;&gt; &quot;University of Wales, Lampeter&quot;&#13;&#10;THEN [Institution]&#13;&#10;END' />
            </column>
            <column caption='University vs. National Avg' datatype='string' name='[Calculation_1058296362848267]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Institution] = [Parameters].[Parameter 1058296362258442] THEN &quot;Chosen University&quot;&#13;&#10;ELSEIF [Calculation_1058296415952922] THEN &quot;Top 10% Avg&quot;&#13;&#10;ELSE &quot;National Avg&quot;&#13;&#10;END' />
            </column>
            <column caption='Uni top 10 % cut off' datatype='boolean' name='[Calculation_1058296415952922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Rank] &lt;= { FIXED: CEILING(0.1 * COUNTD([Institution]))}' />
            </column>
            <column caption='University = University Parameter' datatype='boolean' name='[Calculation_1241090599424001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Institution] = [Parameters].[Parameter 1058296362258442]' />
            </column>
            <column datatype='string' name='[Institution]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Rank]' role='measure' type='quantitative' />
            <column datatype='real' name='[Student Satisfaction]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0319429485846553]' derivation='Avg' name='[avg:Calculation_0319429485846553:qk]' pivot='key' type='quantitative' />
