        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[none:Year:qk]' />
              <lod column='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[none:Year:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'>Data source: University League Tables</run>
                <run>Æ&#10;&#10;&#10;</run>
                <run bold='true'>Definitions:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>Student satisfaction</run>
                <run> is calculated from the National Studen Survey answers

</run>
                <run bold='true'>Research Quality</run>
                <run> is calculated using data from the Research Excellence Framework

</run>
                <run bold='true'>Entry Standards</run>
                <run> measure the average UCAS score of 1st year undergraduate students

</run>
                <run bold='true'>Continuation</run>
                <run> measures how many students continue their studies after the first year

</run>
                <run bold='true'>Graduate Outcomes</run>
                <run> measures graduates&apos; success 15 months after graduating

</run>
                <run bold='true'>Research Intensity</run>
                <run> measures the proportion of teching staff involved in research

</run>
                <run bold='true'>Academic Services Spend</run>
                <run> per student&#10;&#10;</run>
                <run bold='true'>Facilities Spend</run>
                <run> per student</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Custom Shapes/8201.png' />
                <format attr='size' value='1.1974033117294312' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{A8F19043-10D5-446E-85C8-3F8D9B0C1C28}' />
    </worksheet>
