  <worksheets>
    <worksheet name='Bar (Academic Service Benchmark) (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Academic Services Spend                       </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='in (Complete_University_Guide_University_League_Table 1 (3))' name='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='University name' datatype='string' name='[Parameter 1058296362258442]' param-domain-type='list' role='measure' source-field='[federated.0c9gt3o0yhm6ow19s6xib1yjpaxa].[Calculation_0970336804003842]' type='nominal' value='&quot;Brunel University of London&quot;'>
              <calculation class='tableau' formula='&quot;Brunel University of London&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column datatype='integer' name='[Academic Services Spend]' role='measure' type='quantitative' />
            <column caption='Academic Services Spend Neutral' datatype='string' name='[Calculation_0319429459288074]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0718002208759846] = 0 THEN &quot;—&quot; END' />
            </column>
            <column caption='CY National Academic Services Spend' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429485514771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Year] = YEAR(TODAY()) THEN [Academic Services Spend] END )}' />
            </column>
            <column caption='CY Top 10%' datatype='boolean' name='[Calculation_0319429498785820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Year] = { FIXED : AVG(YEAR(TODAY())) }&#13;&#10;AND [Rank] &lt;= { FIXED : CEILING(0.1 * COUNTD([Institution])) }' />
            </column>
            <column caption='CY Academic Services Spend (top 10%)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429499822110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Calculation_0319429498785820] AND [Year] = YEAR(TODAY()) THEN [Academic Services Spend] END) }' />
            </column>
            <column caption='Academic Services Spend YoY' datatype='real' default-format='p0.00%' name='[Calculation_0718002208759846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(IF [Year] = YEAR(TODAY()) THEN [Academic Services Spend] END)&#13;&#10;- AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Academic Services Spend] END))&#13;&#10;/ AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Academic Services Spend] END)' />
