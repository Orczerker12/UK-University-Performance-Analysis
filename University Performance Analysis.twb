            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Pivot Field Values]' derivation='Avg' name='[avg:Pivot Field Values:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0970336863244292]' derivation='None' name='[none:Calculation_0970336863244292:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1241090599424001]' derivation='None' name='[none:Calculation_1241090599424001:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0970336954265626]' derivation='User' name='[usr:Calculation_0970336954265626:qk]' pivot='key' type='quantitative' />
