            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c9gt3o0yhm6ow19s6xib1yjpaxa'>
            <column caption='Research Intensity Neutral' datatype='string' name='[Calculation_0319429459607567]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0718002210967595] = 0 THEN &quot;—&quot; END' />
            </column>
            <column caption='CY National Research Intensity' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429485789208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Year] = YEAR(TODAY()) THEN [Research Intensity] END )}' />
            </column>
            <column caption='CY Top 10%' datatype='boolean' name='[Calculation_0319429498785820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Year] = { FIXED : AVG(YEAR(TODAY())) }&#13;&#10;AND [Rank] &lt;= { FIXED : CEILING(0.1 * COUNTD([Institution])) }' />
            </column>
            <column caption='CY Research Intensity (top 10%)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0319429500207139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(IF [Calculation_0319429498785820] AND [Year] = YEAR(TODAY()) THEN [Research Intensity] END) }' />
            </column>
            <column caption='Research Intensity YoY' datatype='real' default-format='p0.00%' name='[Calculation_0718002210967595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(IF [Year] = YEAR(TODAY()) THEN [Research Intensity] END)&#13;&#10;- AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Research Intensity] END))&#13;&#10;/ AVG(IF [Year] = YEAR(TODAY()) - 1 THEN [Research Intensity] END)' />
            </column>
